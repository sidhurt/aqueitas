# ============================================================
# AQUEITAS ENVIRONMENT CONFIGURATION
# Copy this file to brain/.env and fill in your real values.
# NEVER commit brain/.env to version control.
# ============================================================

# --- Database (matches docker-compose.yml) ---
DB_USER=aqueitas_admin
DB_PASSWORD=your-secure-db-password-here
DB_NAME=aqueitas_db
DATABASE_URL=postgresql://aqueitas_admin:your-secure-db-password-here@127.0.0.1:5433/aqueitas_db

# --- OpenAI (For Embeddings ONLY: text-embedding-3-small) ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- DeepSeek (For Context Engine ONLY: deepseek-chat) ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# --- Provider Selection (every model is replaceable) ---
# EMBEDDING_PROVIDER: openai (default) | fake   (offline, keyless)
# REASONING_PROVIDER: deepseek (default) | passthrough (offline, keyless)
EMBEDDING_PROVIDER=openai
REASONING_PROVIDER=deepseek
