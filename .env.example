# Aqueitas 2.0 Environment Configuration
# Copy this file to .env and fill in your actual keys

# --- AI Model Keys ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- PostgreSQL Database Configuration ---
# Note: These should match your docker-compose.yml configuration
POSTGRES_USER=aqueitas_admin
POSTGRES_PASSWORD=sovereign_password_123
POSTGRES_DB=aqueitas_db
POSTGRES_PORT=5433
POSTGRES_HOST=127.0.0.1
