# Aqueitas 2.0 Environment Configuration
# Copy this file to .env and fill in your actual keys

# --- AI Model Keys ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Provider Selection (every model is replaceable) ---
# EMBEDDING_PROVIDER: openai (default) | fake
#   'fake' = deterministic offline vectors, no API key needed (testing/trial)
# REASONING_PROVIDER: deepseek (default) | passthrough
#   'passthrough' = no LLM calls; commit messages are used as the intent summary
EMBEDDING_PROVIDER=openai
REASONING_PROVIDER=deepseek
# EMBEDDING_MODEL=text-embedding-3-small
# REASONING_MODEL=deepseek-chat
# REASONING_BASE_URL=https://api.deepseek.com

# --- Optional: Atlas remote-worker integration (off by default) ---
# Requires AWS credentials, AQUEITAS_TAILSCALE_IP, TAILSCALE_AUTHKEY,
# AWS_ECS_CLUSTER, AWS_ECS_TASK, AWS_SUBNET_ID
# ATLAS_ENABLED=false

# --- PostgreSQL Database Configuration ---
# Note: These should match your docker-compose.yml configuration
DB_USER=aqueitas_admin
DB_PASSWORD=sovereign_password_123
DB_NAME=aqueitas_db
DB_PORT=5433
DB_HOST=127.0.0.1
DATABASE_URL=postgresql://aqueitas_admin:sovereign_password_123@127.0.0.1:5433/aqueitas_db
